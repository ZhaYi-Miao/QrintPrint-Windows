<Window x:Class="QrintPrint.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QrintPrint — 错题小印 Windows 版"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Layer01Brush}"
        Icon="/icon.ico">

    <Window.Resources>
        <!-- 导航项样式:对应 WinUI 3 NavigationView Item 风格 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="8,2,8,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{StaticResource ContentFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Layer02Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧导航栏(对应 NavigationView) ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource Layer02Brush}">
            <DockPanel LastChildFill="True">

                <!-- 顶部标题区 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,16,20,12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/icon.ico" Width="36" Height="36" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TitleText}"
                                       Text="QrintPrint" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}"
                                       Text="错题小印 Windows 版" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 底部设备状态卡 -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,12"
                        Padding="14,12"
                        CornerRadius="8"
                        Background="{DynamicResource Layer01Brush}"
                        BorderBrush="{DynamicResource ControlStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <!-- 连接状态行 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="ConnDot" Width="8" Height="8"
                                    Fill="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock x:Name="ConnLabel" Margin="8,0,0,0"
                                       Style="{StaticResource BodyStrongText}"
                                       Text="未连接" />
                        </StackPanel>
                        <!-- 设备名 -->
                        <TextBlock x:Name="DeviceNameLabel" Margin="0,0,0,4"
                                   Style="{StaticResource CaptionText}"
                                   Text="—" />
                        <!-- 电量/纸张 -->
                        <TextBlock x:Name="DeviceDetailLabel"
                                   Style="{StaticResource CaptionText}"
                                   Text="电量 — · 纸张 —" />
                    </StackPanel>
                </Border>

                <!-- 导航项 -->
                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectedIndex="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem>
                        <TextBlock Text="首页" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="模版" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="历史" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="我的" />
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══ 右侧内容区 ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页面标题栏 -->
            <Border Grid.Row="0" Padding="32,24,32,16"
                    BorderBrush="{DynamicResource DividerStrokeBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource TitleText}" Text="首页" />
                    <TextBlock x:Name="PageSubtitle" Margin="0,4,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="打印机状态与快捷操作" />
                </StackPanel>
            </Border>

            <!-- 内容容器(运行时切换页面) -->
            <ContentControl x:Name="ContentArea" Grid.Row="1" Margin="32,24" />
        </Grid>
    </Grid>
</Window>
