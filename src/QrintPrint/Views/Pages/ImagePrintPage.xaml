<UserControl x:Class="QrintPrint.Views.Pages.ImagePrintPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧设置面板 ═══ -->
        <Border Grid.Column="0"
                Background="{DynamicResource Layer02Brush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 返回按钮 -->
                    <Button Margin="0,0,0,12" Padding="8,6"
                            HorizontalAlignment="Left"
                            Click="BackBtn_Click"
                            Content="← 返回首页" />

                    <TextBlock Style="{StaticResource SubtitleText}" Text="照片打印" Margin="0,0,0,16" />
                    

                    <!-- 图片选择 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="选择图片" Margin="0,0,0,4" />
                    <Button x:Name="PickBtn" Padding="0,10"
                            HorizontalAlignment="Stretch"
                            Click="PickBtn_Click"
                            Content="选择图片文件" />

                    <TextBlock x:Name="FileNameLabel" Margin="0,8,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="未选择图片" />

                    <!-- 抖动算法 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="抖动算法" Margin="0,20,0,4" />
                    <StackPanel x:Name="DitherOptions" />

                    <!-- 阈值滑块（仅"无"抖动模式显示） -->
                    <StackPanel x:Name="ThresholdPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" Text="阈值" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="255" Value="128"
                                    Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="ThresholdSlider_ValueChanged" />
                            <TextBlock x:Name="ThresholdLabel" Margin="8,0,0,0"
                                       Style="{StaticResource BodyText}" Text="128" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 浓度 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="打印浓度" Margin="0,20,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="5" Value="3"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="ThicknessSlider_ValueChanged" />
                        <TextBlock x:Name="ThicknessLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="3" />
                    </StackPanel>

                    <!-- 打印按钮 -->
                    <Button x:Name="PrintBtn" Margin="0,24,0,0" Padding="0,12"
                            HorizontalAlignment="Stretch"
                            Click="PrintBtn_Click"
                            Content="打印" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ 右侧预览区 ═══ -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SubtitleText}" Text="实时预览" Margin="0,0,0,12" />

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Image x:Name="PreviewImage" Stretch="None" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
