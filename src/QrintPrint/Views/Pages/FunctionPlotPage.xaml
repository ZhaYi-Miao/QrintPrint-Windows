<UserControl x:Class="QrintPrint.Views.Pages.FunctionPlotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:QrintPrint.Views.Controls"
             xmlns:prims="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 顶部工具栏 ─────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource Layer02Brush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="BackBtn_Click" Content="← 返回"
                        Padding="10,5" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Style="{StaticResource SubtitleText}"
                           Text="函数图像打印" VerticalAlignment="Center" />
                <Button x:Name="PrintBtn" Grid.Column="2" Padding="18,6"
                        Content="打印" Click="PrintBtn_Click" />
            </Grid>
        </Border>

        <!-- ── 主体 ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧栏 -->
            <Border Grid.Column="0" Background="{DynamicResource Layer02Brush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="0,0,1,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 页签 -->
                    <Border Grid.Row="0" Background="#EEF1F6" CornerRadius="6" Padding="2" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TabAlgebraBtn" Grid.Column="0" Style="{StaticResource TabButtonStyle}"
                                    Tag="algebra" Click="SideTab_Click" Content="代数区" HorizontalAlignment="Stretch" />
                            <Button x:Name="TabSettingsBtn" Grid.Column="1" Style="{StaticResource TabButtonStyle}"
                                    Tag="settings" Click="SideTab_Click" Content="打印设置" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2">
                        <StackPanel>
                            <!-- ── 代数区 ── -->
                            <StackPanel x:Name="AlgebraPanel">
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="点函数行聚焦光标，用下方键盘输入。结构键：分数、根号、上标、绝对值，按下即成结构。"
                                           Margin="0,0,0,8" />
                                <ItemsControl x:Name="FuncList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" CornerRadius="6"
                                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                                    BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Width="48" Margin="0,0,8,0"
                                                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontFamily="Consolas" FontSize="13" TextAlignment="Center" />
                                                        <c:ExpressionEditor Grid.Column="1"
                                                                            Root="{Binding ExprRoot, Mode=TwoWay}"
                                                                            ExpressionChanged="Editor_ExpressionChanged"
                                                                            EditorGotFocus="Editor_GotFocus"
                                                                            EnterPressed="Editor_EnterPressed" />
                                                        <Button Grid.Column="2" Margin="6,0,0,0" Padding="6,2"
                                                                Foreground="#E5484D" Content="✕"
                                                                Click="DeleteFuncBtn_Click" />
                                                    </Grid>
                                                    <TextBlock Margin="0,4,0,0" FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               Text="{Binding Norm}" />
                                                    <TextBlock Margin="0,1,0,0" FontFamily="Consolas" FontSize="11"
                                                               Foreground="#E5484D" TextWrapping="Wrap"
                                                               Text="{Binding Error}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,2,0,0" Padding="10,6" HorizontalAlignment="Left"
                                        Content="＋ 添加函数" Click="AddFuncBtn_Click" />
                                <TextBlock x:Name="ErrorText" Margin="0,10,0,0"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="#E5484D" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- ── 打印设置 ── -->
                            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource CaptionText}" Text="X 范围" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="XMinBox" Grid.Column="0" Margin="0,0,4,0" Text="-10"
                                             FontFamily="Consolas" FontSize="13" TextAlignment="Center"
                                             TextChanged="RangeBox_TextChanged" />
                                    <TextBox x:Name="XMaxBox" Grid.Column="1" Margin="4,0,0,0" Text="10"
                                             FontFamily="Consolas" FontSize="13" TextAlignment="Center"
                                             TextChanged="RangeBox_TextChanged" />
                                </Grid>

                                <TextBlock Style="{StaticResource CaptionText}" Text="Y 范围（留空自动）" Margin="0,10,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="YMinBox" Grid.Column="0" Margin="0,0,4,0" Text=""
                                             FontFamily="Consolas" FontSize="13" TextAlignment="Center"
                                             TextChanged="RangeBox_TextChanged" />
                                    <TextBox x:Name="YMaxBox" Grid.Column="1" Margin="4,0,0,0" Text=""
                                             FontFamily="Consolas" FontSize="13" TextAlignment="Center"
                                             TextChanged="RangeBox_TextChanged" />
                                </Grid>

                                <TextBlock Style="{StaticResource CaptionText}" Text="图标题（可选）" Margin="0,10,0,4" />
                                <TextBox x:Name="TitleBox" TextChanged="RangeBox_TextChanged" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox x:Name="GridCheck" Content="网格" IsChecked="True"
                                              Checked="RangeBox_TextChanged" Unchecked="RangeBox_TextChanged" />
                                    <CheckBox x:Name="LegendCheck" Content="图例" IsChecked="True" Margin="16,0,0,0"
                                              Checked="RangeBox_TextChanged" Unchecked="RangeBox_TextChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="AxesCheck" Content="坐标轴" IsChecked="True"
                                              Checked="RangeBox_TextChanged" Unchecked="RangeBox_TextChanged" />
                                    <CheckBox x:Name="TickCheck" Content="刻度数值" IsChecked="True" Margin="16,0,0,0"
                                              Checked="RangeBox_TextChanged" Unchecked="RangeBox_TextChanged" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource CaptionText}" Text="标记点" Margin="0,12,0,4" />
                                <ItemsControl x:Name="PointList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="12"
                                                           Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="12"
                                                           Text="{Binding Coord}" />
                                                <Button Grid.Column="2" Margin="6,0,0,0" Padding="4,1"
                                                        Content="×" Click="DeletePointBtn_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,4,0,0" Padding="6,2" HorizontalAlignment="Left"
                                        Content="清空点" Click="ClearPointsBtn_Click" />
                                <Button x:Name="ResetRangeBtn" Margin="0,8,0,0" Padding="8,4"
                                        HorizontalAlignment="Left" Content="恢复默认范围（-10 ~ 10）"
                                        Click="ResetRangeBtn_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 中央画布 -->
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource CaptionText}"
                           Text="实时预览（点击曲线可添加坐标点标记）" Margin="0,0,0,8" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Border Background="White" BorderBrush="{DynamicResource ControlStrokeBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                            MouseMove="Preview_MouseMove"
                            MouseLeftButtonUp="Preview_MouseLeftButtonUp">
                        <Grid x:Name="PreviewHost">
                            <Image x:Name="PreviewImage" Stretch="None" />
                            <Canvas x:Name="RubberCanvas" IsHitTestVisible="False">
                                <Rectangle x:Name="RubberRect" Visibility="Collapsed"
                                           Fill="#334B3FE3" Stroke="#4B3FE3" StrokeThickness="1" />
                            </Canvas>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── 底部数学键盘 ── -->
        <Border Grid.Row="2" Background="#F2F4F9"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="0,1,0,0" Padding="8,6">
            <StackPanel>
                <StackPanel x:Name="KbdTabs" Orientation="Horizontal" Margin="2,0,0,6">
                    <Button Tag="panelNum" Style="{StaticResource TabButtonStyle}" Content="⌨ 123"
                            Click="KbdMode_Click" />
                    <Button Tag="panelFx" Style="{StaticResource TabButtonStyle}" Content="ƒ(x)"
                            Click="KbdMode_Click" />
                    <Button Tag="panelAbc" Style="{StaticResource TabButtonStyle}" Content="ABC"
                            Click="KbdMode_Click" />
                    <Button Tag="panelSym" Style="{StaticResource TabButtonStyle}" Content="#&amp;¬"
                            Click="KbdMode_Click" />
                </StackPanel>

                <prims:UniformGrid x:Name="PanelNum" Columns="8" />
                <prims:UniformGrid x:Name="PanelFx" Columns="8" Visibility="Collapsed" />
                <prims:UniformGrid x:Name="PanelAbc" Columns="8" Visibility="Collapsed" />
                <prims:UniformGrid x:Name="PanelSym" Columns="8" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>