<UserControl x:Class="QrintPrint.Views.Pages.TextPrintPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧设置面板 ═══ -->
        <Border Grid.Column="0"
                Background="{DynamicResource Layer02Brush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 返回按钮 -->
                    <Button Margin="0,0,0,12" Padding="8,6"
                            HorizontalAlignment="Left"
                            Click="BackBtn_Click"
                            Content="← 返回首页" />

                    <TextBlock Style="{StaticResource SubtitleText}" Text="文本打印" Margin="0,0,0,16" />

                    <!-- 文本输入 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="文本内容" Margin="0,0,0,4" />
                    <TextBox x:Name="TextContent" Height="120" TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource ContentFontFamily}"
                             FontSize="14"
                             Padding="8" />

                    <!-- 字体大小 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="字体大小" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="48" Value="24"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="FontSizeSlider_ValueChanged" />
                        <TextBlock x:Name="FontSizeLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="24" />
                    </StackPanel>

                    <!-- 字体样式 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="字体样式" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="BoldCheck" Content="加粗" Margin="0,0,16,0"
                                  Checked="StyleCheck_Changed" Unchecked="StyleCheck_Changed" />
                        <CheckBox x:Name="ItalicCheck" Content="斜体" Margin="0,0,16,0"
                                  Checked="StyleCheck_Changed" Unchecked="StyleCheck_Changed" />
                        <CheckBox x:Name="UnderlineCheck" Content="下划线"
                                  Checked="StyleCheck_Changed" Unchecked="StyleCheck_Changed" />
                    </StackPanel>

                    <!-- LaTeX 公式 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="LaTeX 公式" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="FormulaModeCheck" Content="启用公式识别"
                                  Checked="FormulaModeCheck_Changed" Unchecked="FormulaModeCheck_Changed" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                               Text="用 $...$ 包裹公式内容，如: $E=mc^2$" />

                    <!-- 公式缩放（仅公式模式生效） -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="公式大小" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="FormulaScaleSlider" Minimum="50" Maximum="200" Value="100"
                                Width="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="FormulaScaleSlider_ValueChanged" />
                        <TextBlock x:Name="FormulaScaleLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="100%" />
                    </StackPanel>

                    <!-- 字间距 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="字间距（点）" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="LetterSpacingSlider" Minimum="0" Maximum="8" Value="0"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="LetterSpacingSlider_ValueChanged" />
                        <TextBlock x:Name="LetterSpacingLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="0" />
                    </StackPanel>

                    <!-- 行间距 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="行间距（点）" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="LineSpacingSlider" Minimum="0" Maximum="20" Value="6"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="LineSpacingSlider_ValueChanged" />
                        <TextBlock x:Name="LineSpacingLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="6" />
                    </StackPanel>

                    <!-- 边距 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="边距（点）" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="MarginSlider" Minimum="0" Maximum="32" Value="8"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="MarginSlider_ValueChanged" />
                        <TextBlock x:Name="MarginLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="8" />
                    </StackPanel>

                    <!-- 文字增强（浓度指令不生效的机器，靠它提清晰度） -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="文字增强" Margin="0,16,0,4" />
                    <ComboBox x:Name="EnhanceCombo"
                              SelectionChanged="EnhanceCombo_SelectionChanged" />
                    <TextBlock x:Name="EnhanceHint" Margin="0,4,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="原始渲染，不做增强" />

                    <!-- 打印按钮 -->
                    <Button x:Name="PrintBtn" Margin="0,24,0,0" Padding="0,12"
                            HorizontalAlignment="Stretch"
                            Click="PrintBtn_Click"
                            Content="打印" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ 右侧预览区 ═══ -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SubtitleText}" Text="实时预览" Margin="0,0,0,12" />

            <!-- 预览容器（384 点宽，按显示宽度缩放） -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Image x:Name="PreviewImage" Stretch="None" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
