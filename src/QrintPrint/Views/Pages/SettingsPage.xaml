<UserControl x:Class="QrintPrint.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <!-- 设备信息 -->
            <TextBlock Style="{StaticResource SubtitleText}" Text="设备信息" Margin="0,0,0,16" />
            <Border Background="{DynamicResource Layer02Brush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}" Text="设备名称" />
                        <TextBlock x:Name="DeviceNameValue" Grid.Column="1" Style="{StaticResource BodyText}" Text="—" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}" Text="设备型号" />
                        <TextBlock x:Name="DeviceModelValue" Grid.Column="1" Style="{StaticResource BodyText}" Text="—" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}" Text="固件版本" />
                        <TextBlock x:Name="FirmwareValue" Grid.Column="1" Style="{StaticResource BodyText}" Text="—" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}" Text="连接状态" />
                        <TextBlock x:Name="ConnStateValue" Grid.Column="1" Style="{StaticResource BodyText}" Text="未连接" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 蓝牙设置 -->
            <TextBlock Style="{StaticResource SubtitleText}" Text="蓝牙设置" Margin="0,0,0,16" />
            <Border Background="{DynamicResource Layer02Brush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                <StackPanel>
                    <CheckBox x:Name="AutoReconnectCheck" Content="自动重连上次设备"
                              Margin="0,4" Checked="AutoReconnectCheck_Changed" Unchecked="AutoReconnectCheck_Changed" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                               Text="开启后，应用启动时会自动尝试连接上次使用的打印机" />

                    <Button Margin="0,16,0,0" Padding="12,8" HorizontalAlignment="Left"
                            Click="ForgetDeviceBtn_Click" Content="忘记当前设备" />
                </StackPanel>
            </Border>

            <!-- 打印设置 -->
            <TextBlock Style="{StaticResource SubtitleText}" Text="打印设置" Margin="0,0,0,16" />
            <Border Background="{DynamicResource Layer02Brush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="默认浓度" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="DefaultThicknessSlider" Minimum="1" Maximum="5" Value="3"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="DefaultThicknessSlider_ValueChanged" />
                        <TextBlock x:Name="DefaultThicknessLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="3" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                               Text="设置新建打印任务时的默认浓度等级（1-5）" />

                    <TextBlock Style="{StaticResource CaptionText}" Text="纸张宽度" Margin="0,16,0,4" />
                    <ComboBox x:Name="PaperWidthCombo" Width="140" HorizontalAlignment="Left"
                              SelectionChanged="PaperWidthCombo_SelectionChanged">
                        <ComboBoxItem Tag="50" Content="50mm（默认）" />
                        <ComboBoxItem Tag="57" Content="57mm" />
                    </ComboBox>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Text="按实际使用的热敏纸宽度选择，所有预览的纸条宽度随之变化；打印内容宽度固定为打印头 48mm，自动居中" />
                </StackPanel>
            </Border>

            <!-- 远程打印服务 -->
            <TextBlock Style="{StaticResource SubtitleText}" Text="远程打印服务" Margin="0,0,0,16" />
            <Border Background="{DynamicResource Layer02Brush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                <StackPanel>
                    <CheckBox x:Name="ApiEnableCheck" Content="启用远程打印服务（局域网 HTTP API）"
                              Margin="0,4" Checked="ApiEnableCheck_Changed" Unchecked="ApiEnableCheck_Changed" />
                    <TextBlock x:Name="ApiStatusText" Margin="0,4,0,0"
                               Style="{StaticResource CaptionText}" Text="已停止" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}"
                                   Text="端口" VerticalAlignment="Center" />
                        <TextBox x:Name="ApiPortBox" Grid.Column="1" Text="8512"
                                 Width="120" HorizontalAlignment="Left"
                                 LostFocus="ApiPortBox_LostFocus" />
                    </Grid>

                    <TextBlock Style="{StaticResource SubtitleText}" Text="API Key 管理" Margin="0,16,0,4" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}"
                                   Text="新建 Key" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="NewKeyNameBox" Width="180"
                                     VerticalAlignment="Center" />
                            <CheckBox x:Name="NewKeyAdminCheck" Content="管理员（全权限）"
                                      VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Margin="8,0,0,0" Padding="10,4"
                                Content="创建" Click="AddKeyBtn_Click" />
                    </Grid>

                    <TextBlock Margin="0,12,0,4" Style="{StaticResource CaptionText}"
                               Text="已配置的 Key（选中可查看令牌与权限）" />
                    <ListBox x:Name="ApiKeyList" Height="120" Margin="0,0,0,0"
                             SelectionChanged="ApiKeyList_SelectionChanged"
                             Background="{DynamicResource Layer02Brush}"
                             BorderBrush="{DynamicResource ControlStrokeBrush}"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Style="{StaticResource BodyStrongText}">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding KindLabel, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="11"
                                               Text="{Binding Token}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}"
                                   Text="访问令牌" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="SelectedKeyTokenBox"
                                 VerticalAlignment="Center"
                                 FontFamily="{StaticResource ContentFontFamily}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Padding="10,4" Content="复制"
                                    Click="CopyTokenBtn_Click" />
                            <Button Margin="8,0,0,0" Padding="10,4"
                                    Content="保存令牌" Click="SaveTokenBtn_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap"
                               Text="令牌保持固定不变（按电脑特征稳定派生，配置丢失也不改变）。如需自定义，直接修改后点“保存令牌”即可。" />

                    <TextBlock Margin="0,12,0,4" Style="{StaticResource CaptionText}"
                               Text="接口权限（管理员 Key 自动拥有全部；普通 Key 仅可访问勾选的接口）" />
                    <ItemsControl x:Name="PermissionPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button Margin="0,12,0,0" Padding="10,4" HorizontalAlignment="Left"
                            Content="删除选中的 Key" Click="DeleteKeyBtn_Click" />

                    <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap"
                               Text="局域网内设备通过 HTTP API 远程打印（请求头携带 X-Api-Token）。不同 Key 可分配不同权限，例如只给他人开放文本打印。如需公网访问，请自行配置 frp 等内网穿透，务必做好鉴权。" />
                </StackPanel>
            </Border>

            <!-- 虚拟打印机 -->
            <TextBlock Style="{StaticResource SubtitleText}" Text="虚拟打印机" Margin="0,0,0,16" />
            <Border Background="{DynamicResource Layer02Brush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}"
                                   Text="数据通道" VerticalAlignment="Center" />
                        <ComboBox x:Name="VpModeCombo" Grid.Column="1" Width="260"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="VpModeCombo_SelectionChanged">
                            <ComboBoxItem Tag="tcp" Content="TCP 端口接收（零依赖，推荐）" />
                            <ComboBoxItem Tag="redmon" Content="RedMon 端口（可传二进制，需 DLL）" />
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="VpEnableCheck" Content="启用虚拟打印机（其他软件可直接打印到本打印机）"
                              Margin="0,8,0,0" Checked="VpEnableCheck_Changed" Unchecked="VpEnableCheck_Changed" />
                    <TextBlock x:Name="VpStatusText" Margin="0,4,0,0"
                               Style="{StaticResource CaptionText}" Text="未启用" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Text="启用后系统会创建一个“QrintPrint 虚拟打印机”队列，Word / 浏览器 / 订单系统等任何软件都能直接打印到热敏打印机。首次启用会安装 RedMon 端口监视器并创建队列，需要管理员权限（会弹出 UAC 授权窗口）。" />
                </StackPanel>
            </Border>

            <!-- 运行日志 -->
            <TextBlock Style="{StaticResource SubtitleText}" Text="运行日志" Margin="0,0,0,16" />
            <Border Background="{DynamicResource Layer02Brush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="清空日志" Click="ClearLogBtn_Click" Padding="10,4" />
                        <Button Content="打开日志文件夹" Click="OpenLogFolderBtn_Click"
                                Padding="10,4" Margin="8,0,0,0" />
                        <TextBlock Margin="12,0,0,0" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Text="实时记录程序操作与收到的数据（USB / 蓝牙 / 远程打印）" />
                    </StackPanel>
                    <ListBox x:Name="LogListBox" Height="320" Margin="0,12,0,0"
                             FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource Layer02Brush}"
                             BorderBrush="{DynamicResource ControlStrokeBrush}"
                             BorderThickness="1"
                             PreviewMouseWheel="LogListBox_PreviewMouseWheel"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <TextBlock Style="{StaticResource SubtitleText}" Text="关于" Margin="0,0,0,16" />
            <Border Background="{DynamicResource Layer02Brush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongText}" Text="热印 ThermoPrint" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                               Text="错题小印 Windows 版 v1.1.3" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}"
                               Text="基于 Qring 私有协议，支持文本、照片、条码、自定义画布打印" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}"
                               Text="ZhaYi &amp; DeepSeek" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}"
                               Text="打印机交流群号：419668261" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                        <Run Text="GitHub 仓库：" />
                        <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"
                                   NavigateUri="https://github.com/ZhaYi-Miao/QrintPrint-Windows">
                            QrintPrint-Windows（桌面程序）
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                        <Run Text="Web 控制台：" />
                        <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"
                                   NavigateUri="https://github.com/ZhaYi-Miao/QrintPrint-Web-Console">
                            QrintPrint-Web-Console（网页打印面板）
                        </Hyperlink>
                    </TextBlock>

                    <!-- 检查更新 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="检查更新" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckUpdateBtn" Content="检查更新"
                                Click="CheckUpdateBtn_Click" Padding="10,4" />
                        <Button x:Name="DownloadUpdateBtn" Content="下载最新版"
                                Click="DownloadUpdateBtn_Click" Padding="10,4" Margin="8,0,0,0"
                                Visibility="Collapsed" />
                    </StackPanel>
                    <CheckBox x:Name="AutoCheckUpdateCheck" Content="自动检查更新（程序启动时检查，发现新版本自动提示）"
                              Margin="0,8,0,0"
                              Checked="AutoCheckUpdateCheck_Changed" Unchecked="AutoCheckUpdateCheck_Changed" />
                    <CheckBox x:Name="UseProxyCheck" Content="使用系统代理（访问 GitHub 受限/403 时勾选）"
                              Margin="0,8,0,0" IsChecked="True" />
                    <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,8,0,0"
                                 Visibility="Collapsed" Maximum="100" />
                    <TextBlock x:Name="UpdateStatusText" Margin="0,8,0,0"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Text="点击按钮检查 GitHub 最新版本" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
