<UserControl x:Class="QrintPrint.Views.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleText}"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="SubtitleText" Margin="0,8,0,0"
                   Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Center" />
        <TextBlock Margin="0,24,0,0" Style="{StaticResource BodyText}"
                   HorizontalAlignment="Center"
                   Text="(此页面待实现)" />
    </StackPanel>
</UserControl>
