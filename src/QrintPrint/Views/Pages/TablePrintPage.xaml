<UserControl x:Class="QrintPrint.Views.Pages.TablePrintPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧设置面板 ═══ -->
        <Border Grid.Column="0"
                Background="{DynamicResource Layer02Brush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Margin="0,0,0,12" Padding="8,6"
                            HorizontalAlignment="Left"
                            Click="BackBtn_Click"
                            Content="← 返回首页" />

                    <TextBlock Style="{StaticResource SubtitleText}" Text="表格打印" Margin="0,0,0,16" />

                    <!-- 列数 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="列数" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="ColSlider" Minimum="1" Maximum="8" Value="3"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="ColSlider_ValueChanged" />
                        <TextBlock x:Name="ColLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="3" />
                    </StackPanel>

                    <!-- 行数 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="行数" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="RowSlider" Minimum="1" Maximum="20" Value="4"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="RowSlider_ValueChanged" />
                        <TextBlock x:Name="RowLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="4" />
                    </StackPanel>

                    <!-- 字体大小 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="字体大小" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="32" Value="16"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="FontSizeSlider_ValueChanged" />
                        <TextBlock x:Name="FontSizeLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="16" />
                    </StackPanel>

                    <!-- 边距 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="边距（点）" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="MarginSlider" Minimum="2" Maximum="20" Value="6"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="MarginSlider_ValueChanged" />
                        <TextBlock x:Name="MarginLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="6" />
                    </StackPanel>

                    <!-- 打印按钮 -->
                    <Button x:Name="PrintBtn" Margin="0,24,0,0" Padding="0,12"
                            HorizontalAlignment="Stretch"
                            Click="PrintBtn_Click"
                            Content="打印" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ 右侧编辑+预览区 ═══ -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SubtitleText}" Text="表格内容" Margin="0,0,0,8" />

            <!-- 表格编辑器 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid x:Name="TableGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="False"
                          GridLinesVisibility="All"
                          BorderBrush="{DynamicResource ControlStrokeBrush}"
                          BorderThickness="1"
                          FontFamily="{StaticResource ContentFontFamily}"
                          FontSize="14"
                          ColumnWidth="*"
                          CellEditEnding="TableGrid_CellEditEnding" />
            </ScrollViewer>

            <TextBlock Grid.Row="2" Style="{StaticResource SubtitleText}" Text="实时预览" Margin="0,16,0,8" />

            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Image x:Name="PreviewImage" Stretch="None" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
