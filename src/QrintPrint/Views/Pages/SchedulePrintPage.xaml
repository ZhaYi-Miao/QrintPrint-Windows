<UserControl x:Class="QrintPrint.Views.Pages.SchedulePrintPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧设置面板 ═══ -->
        <Border Grid.Column="0"
                Background="{DynamicResource Layer02Brush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Margin="0,0,0,12" Padding="8,6"
                            HorizontalAlignment="Left"
                            Click="BackBtn_Click"
                            Content="← 返回首页" />

                    <TextBlock Style="{StaticResource SubtitleText}" Text="课程表打印" Margin="0,0,0,16" />

                    <!-- 节数 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="每天节数" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="PeriodSlider" Minimum="4" Maximum="12" Value="8"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="PeriodSlider_ValueChanged" />
                        <TextBlock x:Name="PeriodLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="8" />
                    </StackPanel>

                    <!-- 字体大小 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="字体大小" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="20" Value="12"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="FontSizeSlider_ValueChanged" />
                        <TextBlock x:Name="FontSizeLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="12" />
                    </StackPanel>

                    <!-- 边距 -->
                    <TextBlock Style="{StaticResource CaptionText}" Text="边距（点）" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="MarginSlider" Minimum="2" Maximum="16" Value="4"
                                Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="MarginSlider_ValueChanged" />
                        <TextBlock x:Name="MarginLabel" Margin="8,0,0,0"
                                   Style="{StaticResource BodyText}" Text="4" />
                    </StackPanel>

                    <!-- 打印按钮 -->
                    <Button x:Name="PrintBtn" Margin="0,24,0,0" Padding="0,12"
                            HorizontalAlignment="Stretch"
                            Click="PrintBtn_Click"
                            Content="打印" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ 右侧编辑+预览区 ═══ -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SubtitleText}" Text="课程表内容（点击单元格编辑）" Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid x:Name="ScheduleGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="False"
                          GridLinesVisibility="All"
                          BorderBrush="{DynamicResource ControlStrokeBrush}"
                          BorderThickness="1"
                          FontFamily="{StaticResource ContentFontFamily}"
                          FontSize="14"
                          ColumnWidth="*"
                          CellEditEnding="ScheduleGrid_CellEditEnding" />
            </ScrollViewer>

            <TextBlock Grid.Row="2" Style="{StaticResource SubtitleText}" Text="实时预览" Margin="0,16,0,8" />

            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Image x:Name="PreviewImage" Stretch="None" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
