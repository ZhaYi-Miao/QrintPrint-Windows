<UserControl x:Class="QrintPrint.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 顶部状态横条 ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Layer02Brush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 连接指示 -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{DynamicResource TextTertiaryBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusLabel" Margin="8,0,0,0"
                               Style="{StaticResource BodyStrongText}"
                               Text="未连接" />
                </StackPanel>

                <!-- 分隔线 -->
                <Border Grid.Column="1"
                        BorderBrush="{DynamicResource DividerStrokeBrush}"
                        BorderThickness="1,0,0,0"
                        Margin="16,4" />

                <!-- 状态明细 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="电量" />
                        <TextBlock x:Name="BatteryValue" Margin="6,0,0,0"
                                   Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" Text="—" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="纸张" />
                        <TextBlock x:Name="PaperValue" Margin="6,0,0,0"
                                   Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" Text="—" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="机器状态" />
                        <TextBlock x:Name="HardwareValue" Margin="6,0,0,0"
                                   Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" Text="—" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="浓度" />
                        <TextBlock x:Name="ThicknessValue" Margin="6,0,0,0"
                                   Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" Text="—" />
                    </StackPanel>
                </StackPanel>

                <!-- 连接按钮 -->
                <Button x:Name="ConnBtn" Grid.Column="4" Padding="16,8"
                        VerticalAlignment="Center"
                        Click="ConnBtn_Click"
                        Content="连接打印机" />
            </Grid>
        </Border>

        <!-- ═══ 快捷打印 ═══ -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Style="{StaticResource SubtitleText}" Text="快捷打印" />
            <TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionText}"
                       Text="常用打印功能，点击进入对应页面" />
            <UniformGrid Columns="4" Rows="1">
                <Button Style="{StaticResource QuickActionButton}" Margin="0,0,8,0" Padding="12,20"
                        Click="QuickAction_Click" Tag="image" MinHeight="104">
                    <StackPanel IsHitTestVisible="False">
                        <Path Data="{StaticResource IconPhoto}" Stretch="Uniform"
                              Width="26" Height="26"
                              HorizontalAlignment="Center"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              IsHitTestVisible="False" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongText}"
                                   HorizontalAlignment="Center" Text="照片打印"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Text="抖动算法"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}" Margin="8,0,8,0" Padding="12,20"
                        Click="QuickAction_Click" Tag="text" MinHeight="104">
                    <StackPanel IsHitTestVisible="False">
                        <Path Data="{StaticResource IconText}" Stretch="Uniform"
                              Width="26" Height="26"
                              HorizontalAlignment="Center"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              IsHitTestVisible="False" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongText}"
                                   HorizontalAlignment="Center" Text="文本打印"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Text="字体排版"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}" Margin="8,0,8,0" Padding="12,20"
                        Click="QuickAction_Click" Tag="code" MinHeight="104">
                    <StackPanel IsHitTestVisible="False">
                        <Path Data="{StaticResource IconBarcode}" Stretch="Uniform"
                              Width="26" Height="26"
                              HorizontalAlignment="Center"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              IsHitTestVisible="False" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongText}"
                                   HorizontalAlignment="Center" Text="条码打印"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Text="一维 / 二维"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}" Margin="8,0,0,0" Padding="12,20"
                        Click="QuickAction_Click" Tag="custom" MinHeight="104">
                    <StackPanel IsHitTestVisible="False">
                        <Path Data="{StaticResource IconCustom}" Stretch="Uniform"
                              Width="26" Height="26"
                              HorizontalAlignment="Center"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              IsHitTestVisible="False" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongText}"
                                   HorizontalAlignment="Center" Text="自定义打印"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Text="画布模板"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ 文档打印 ═══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Layer02Brush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleText}" Text="文档打印" />
                <TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionText}"
                           Text="支持 Word、PDF、表格、课程表、Markdown 等多种格式" />
                <WrapPanel>
                    <Button Style="{StaticResource QuickActionButton}" Padding="24,12" Margin="0,0,8,8"
                            Click="QuickAction_Click" Tag="word" MinHeight="48">
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                            <TextBlock Style="{StaticResource BodyStrongText}"
                                       Text="Word 文档" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Text=".docx" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickActionButton}" Padding="24,12" Margin="0,0,8,8"
                            Click="QuickAction_Click" Tag="pdf" MinHeight="48">
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                            <TextBlock Style="{StaticResource BodyStrongText}"
                                       Text="PDF 文档" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Text=".pdf" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickActionButton}" Padding="24,12" Margin="0,0,8,8"
                            Click="QuickAction_Click" Tag="table" MinHeight="48">
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                            <TextBlock Style="{StaticResource BodyStrongText}"
                                       Text="表格" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Text="自定义行列" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickActionButton}" Padding="24,12" Margin="0,0,8,8"
                            Click="QuickAction_Click" Tag="schedule" MinHeight="48">
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                            <TextBlock Style="{StaticResource BodyStrongText}"
                                       Text="课程表" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Text="周计划" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickActionButton}" Padding="24,12" Margin="0,0,8,8"
                            Click="QuickAction_Click" Tag="markdown" MinHeight="48">
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                            <TextBlock Style="{StaticResource BodyStrongText}"
                                       Text="Markdown" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Text="文本渲染" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══ 虚拟打印 ═══ -->
        <Border Grid.Row="3"
                Margin="0,20,0,0"
                Background="{DynamicResource Layer02Brush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                VerticalAlignment="Top">
            <Button Style="{StaticResource QuickActionButton}" Padding="16,14"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Click="QuickAction_Click" Tag="vprint">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconPrinter}" Stretch="Uniform"
                          Width="20" Height="20"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          IsHitTestVisible="False" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0"
                               Style="{StaticResource BodyStrongText}"
                               VerticalAlignment="Center"
                               Text="虚拟打印"
                               IsHitTestVisible="False" />
                    <TextBlock x:Name="VPrintStatusText" Grid.Column="3" Margin="12,0,0,0"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Text="未启用 · 任意软件 Ctrl+P 直接打印"
                               IsHitTestVisible="False" />
                </Grid>
            </Button>
        </Border>
    </Grid>
</UserControl>
