<UserControl x:Class="QrintPrint.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 打印机状态卡 + 快捷操作宫格,按草图布局 -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ 打印机状态卡 ═══ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Layer02Brush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubtitleText}" Text="打印机状态" />

                    <!-- 连接指示行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{DynamicResource TextTertiaryBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusLabel" Margin="8,0,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="未连接" />
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource DividerStrokeBrush}"
                            BorderThickness="0,0,0,1" Margin="0,0,0,8" />

                    <!-- 状态明细 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Style="{StaticResource CaptionText}" Width="56" Text="电量" />
                        <TextBlock x:Name="BatteryValue" Style="{StaticResource BodyStrongText}"
                                   HorizontalAlignment="Right" Text="—" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Style="{StaticResource CaptionText}" Width="56" Text="纸张" />
                        <TextBlock x:Name="PaperValue" Style="{StaticResource BodyStrongText}"
                                   HorizontalAlignment="Right" Text="—" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Style="{StaticResource CaptionText}" Width="56" Text="温度" />
                        <TextBlock x:Name="HardwareValue" Style="{StaticResource BodyStrongText}"
                                   HorizontalAlignment="Right" Text="—" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Style="{StaticResource CaptionText}" Width="56" Text="浓度" />
                        <TextBlock x:Name="ThicknessValue" Style="{StaticResource BodyStrongText}"
                                   HorizontalAlignment="Right" Text="—" />
                    </StackPanel>

                    <!-- 连接/断开按钮 -->
                    <Button x:Name="ConnBtn" Margin="0,16,0,0" Padding="12,8"
                            HorizontalAlignment="Stretch"
                            Click="ConnBtn_Click"
                            Content="连接打印机" />
                </StackPanel>
            </Border>

            <!-- ═══ 快捷操作 2×2 宫格 ═══ -->
            <UniformGrid Grid.Column="1" Columns="2" Rows="2" Margin="16,0,0,0" MinHeight="200">
                <Button Style="{StaticResource QuickActionButton}" Margin="0,0,8,8" Padding="16,20"
                        Click="QuickAction_Click" Tag="image" MinHeight="80">
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource SubtitleText}"
                                   HorizontalAlignment="Center" Text="照片打印"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Text="抖动算法"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}" Margin="8,0,0,8" Padding="16,20"
                        Click="QuickAction_Click" Tag="text" MinHeight="80">
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource SubtitleText}"
                                   HorizontalAlignment="Center" Text="文本打印"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Text="字体排版"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}" Margin="0,8,8,0" Padding="16,20"
                        Click="QuickAction_Click" Tag="code" MinHeight="80">
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource SubtitleText}"
                                   HorizontalAlignment="Center" Text="条码打印"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Text="一维 / 二维"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}" Margin="8,8,0,0" Padding="16,20"
                        Click="QuickAction_Click" Tag="custom" MinHeight="80">
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource SubtitleText}"
                                   HorizontalAlignment="Center" Text="自定义打印"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Text="画布模板"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>

        <!-- ═══ 文档打印区域 ═══ -->
        <Border Grid.Row="1"
                Background="{DynamicResource Layer02Brush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleText}" Text="文档打印" />
                <TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionText}"
                           Text="支持 Word 文档解析，含 LaTeX 公式识别" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource QuickActionButton}" Padding="24,12"
                            Click="QuickAction_Click" Tag="word" MinHeight="48">
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                            <TextBlock Style="{StaticResource BodyStrongText}"
                                       Text="Word 文档打印" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Text=".docx / 公式识别" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部说明 -->
        <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}"
                   Text="点击快捷操作 → 进入对应打印页(左侧设置面板 + 右侧实时预览)"
                   VerticalAlignment="Top" />
    </Grid>
</UserControl>
