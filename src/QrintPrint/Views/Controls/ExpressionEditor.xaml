<UserControl x:Class="QrintPrint.Views.Controls.ExpressionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Layer02Brush}"
            BorderBrush="{DynamicResource ControlStrokeBrush}"
            BorderThickness="1" CornerRadius="4" Padding="4,2">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ContentControl x:Name="RootHost" />
        </ScrollViewer>
    </Border>
</UserControl>
